<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Quest Log" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    
    <header>
      
      <div class="logo" >
        <h1>Quest Log</h1>
      </div>
      
      <div class="player" >
        
        <% if current_user %>
          
          <div class= "player-info">
            
            <% if current_user.icon.attached? %>
              <%= image_tag current_user.icon,class: "user-icon" %>
            <% else %>
              <%= image_tag "defo.icon.png",class: "user-icon" %>
            <% end %>
            
            <div>
              <p><%= current_user.name %></p>

              <% if current_user.guest? %>
                <small>ゲスト冒険者</small>
              <% end %>

              <%= link_to "ログアウト",destroy_user_session_path,data:{ turbo_method: :delete } %>
            
            </div>
          
          </div>

        <% else %>

          <div class= "player-info">
            <%= image_tag "defo.icon.png",class:"user-icon" %>
          </div>
        
        <% end %>

      </div>

    </header>

    <main>
      <%= yield %>
    </main>

    <footer>

      <% if current_user  %>

        <nav>
          <%= link_to "🏠Home", tasks_path %>
          <%= link_to "📜Todo" , todo_lists_path %>
          <%= link_to "⚔Habit" , habits_path %>
          <%= link_to "＋Todo" , new_todo_list_path %>
          <%= link_to "＋habit" , new_habit_path %>
        </nav>

      <% end %>

    </footer>

  </body>

</html>