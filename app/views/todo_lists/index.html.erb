<h2>todo_list</h2>
<h3>デイリー</h3>
<% @todo_lists_daily.each do |daily| %>
    <dl>
      <dt>名前</dt>
      <dd><%= daily.task.name %></dd>
      <dt>内容</dt>
      <dd><%= daily.task.description %></dd>
      <dt>終了日</dt>
      <dd><%= daily.deadline.to_date %></dd>
      <dt>最大継続日数</dt>
      <dd><%= daily.task.keep_count %>
    </dl>
    <%= button_to "#{daily.task.name}完了!",completions_path(task_id: daily.task.id),method: :post %>
    <%= button_to "削除" ,todo_list_path(daily),method: :delete %>
  <%= button_to "編集" ,edit_todo_list_path(daily),method: :get %>
<% end %>

